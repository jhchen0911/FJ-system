rules_version = '2';
// Firebase Storage 安全規則（repo 原始碼；改完必須到 Firebase 主控台 Storage → 規則 貼上發布才生效）
// v6.0.112（健檢2 #6）：改成與系統「人員管理 → 產生 Storage 規則」同一版，以登入帳號的權限標記（claim fy）判斷：
//   fy＝admin／staff 可讀寫附件，fy＝reader（唯讀帳號）只能讀，沒有 fy（陌生帳號、已從名冊移除的人）全部拒絕。
//   claim fy 由 Cloud Functions（functions/index.js）依 RTDB 名冊自動設定。這份沒有人員名單後備：
//   **直接貼這份要等 functions 部署、按過「重新同步附件權限」、大家重新登入之後**，否則員工還沒拿到 claim 會被擋。
//   回國清單第 2 步用的是人員管理頁「產生 Storage 規則」的版本（同樣邏輯、另含人員名單後備），可以先發布。
// app 用到的全部路徑：
//   fydata/backups/<日期>.json      每日／每月雲端快照（含 private 敏感資料）→ 只給擁有者
//   fydata/projfiles/<qid>/<類型>/…  工程專案附件、工作確認單
//   fydata/payfiles/<pid>/…          應付附件（廠商請款單、匯款單）
//   fydata/einv/…                    發票影像
//   contracts/<uid>/…                合約附件
//   line/…                           LINE 機器人檔案（Cloud Functions 寫入）
// 其餘路徑一律拒絕。
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function em() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return signedIn() && em() in ['jhchen0911@gmail.com'];
    }
    // 唯讀帳號（AI 助理）：claim fy＝reader，或列在這裡的帳號（claim 尚未生效時的後備）
    function isReader() {
      return signedIn() && (request.auth.token.get('fy', '') == 'reader' || em() in ['hsuanchen911@gmail.com']);
    }
    function isStaff() {
      return signedIn() && !isReader() && (request.auth.token.get('fy', '') in ['staff', 'admin'] || isOwner());
    }
    match /fydata/backups/{file=**} {
      allow read, write: if isOwner();
    }
    match /fydata/{folder}/{rest=**} {
      allow read: if (isStaff() || isReader()) && folder in ['projfiles', 'payfiles', 'einv'];
      allow write: if isStaff() && folder in ['projfiles', 'payfiles', 'einv'];
    }
    match /contracts/{rest=**} {
      allow read: if isStaff() || isReader();
      allow write: if isStaff();
    }
    match /line/{rest=**} {
      allow read: if isStaff() || isReader();
      allow write: if false;
    }
  }
}
