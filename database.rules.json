{
  "rules": {
    ".read": false,
    ".write": false,

    "fydata": {
      "shared": {
        ".read": "auth != null",
        ".write": "auth != null",

        "admins": {
          ".write": "auth != null && (!data.exists() || data.val().contains(auth.token.email))"
        }
      },

      "private": {
        ".read": "auth != null && root.child('fydata/adminUids').child(auth.uid).exists()",
        ".write": "auth != null && root.child('fydata/adminUids').child(auth.uid).exists()"
      },

      "adminUids": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && (!root.child('fydata/adminUids').exists() || root.child('fydata/adminUids').child(auth.uid).exists())"
        }
      },

      "backups": {
        ".read": "auth != null && root.child('fydata/adminUids').child(auth.uid).exists()",
        ".write": "auth != null && root.child('fydata/adminUids').child(auth.uid).exists()"
      },

      "logs": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
